# Copy this to .env and fill in values (do not commit secrets)

# Database (local MongoDB by default)
MONGO_URI=mongodb://localhost:27017/arecanut_grading

# Auth (replace the placeholder; minimum 16 characters; never commit the real value)
JWT_SECRET=replace_with_a_random_secret_at_least_16_chars
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=10

# ML inference
ML_TRANSPORT=local
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=120000
PYTHON_PATH=python
# Paths below are resolved from the project root, not from server/
MODEL_PATH=ml_service/weights/best.pt
MODEL_METADATA_PATH=ml_service/model_metadata.json

# Dense-image inference tuning (see README)
MODEL_CONF=0.05
MODEL_IMGSZ=1280
MODEL_IOU=0.50
MODEL_MAX_DET=2000
MODEL_AUGMENT=false
USE_TILED=true
TILE_SIZE=640
TILE_OVERLAP=0.25
# Tiles run at native size; MODEL_IMGSZ is used for the full-image path.
TILE_IMGSZ=640
# Cross-tile de-duplication (separate from the model's own NMS)
TILE_MERGE_IOU=0.45
TILE_DUPLICATE_CENTER_RATIO=0.30
TILE_CORE_OWNERSHIP=false
TILE_MIN_IMAGE_FACTOR=1.5
TILE_INCLUDE_FULL_IMAGE=false
# Persistent local inference worker (loads the model once per server lifetime)
USE_INFERENCE_WORKER=true
ML_WORKER_STARTUP_TIMEOUT_MS=90000
# Developer diagnostics only; keep false for normal use
MODEL_DEBUG=false
DEBUG_CONF_FLOOR=0.01

# Gemini-assisted analysis (optional) for Grade C/D advisory and image-level defect findings.
# Keys are read only by the server, never returned by the API, and never sent to the client.
# Provide one key or up to ten (GEMINI_API_KEY_1 .. GEMINI_API_KEY_10); they are deduplicated
# and used in order with cooldown/failover. Leave blank to keep Gemini unavailable.
# Defect findings require the corresponding admin switches and never create bounding boxes,
# defect locations, affected-nut counts, or fungal confirmations.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Defaults only; the admin UI can override the model, timeout, retry count, and image size.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_IMAGE_MAX_DIMENSION=1280
GEMINI_COOLDOWN_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=900

# AGMARKNET daily mandi prices. The public AGMARKNET 2.0 dashboard is the
# default keyless source. Live pricing also requires an admin to select Live
# Market Price mode.
MARKET_PRICE_SOURCE=agmarknet_public
MARKET_PUBLIC_BASE_URL=https://api.agmarknet.gov.in/v1
MARKET_FILTERS_CACHE_MINUTES=360
MARKET_LOOKBACK_DAYS=7
MARKET_PRICE_TIMEOUT_MS=20000
MARKET_PRICE_CACHE_MINUTES=360

# Optional data.gov.in fallback when MARKET_PRICE_SOURCE=data_gov_in, or when
# the public dashboard fails. DATA_GOV_IN_API_KEY is preferred;
# AGMARKNET_API_KEY is accepted as a legacy alias.
DATA_GOV_IN_API_KEY=
AGMARKNET_API_KEY=
MARKET_PRICE_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070

# Roboflow (optional, inspection/training reference only; not used at request time)
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://api.roboflow.com
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_GRADE=
ROBOFLOW_WORKFLOW_RIPENESS=
ROBOFLOW_WORKFLOW_RIPENESS_ALT=
ROBOFLOW_WORKFLOW_DETECT=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_MAX=600
BCRYPT_ROUNDS=10

# Admin bootstrap (local/dev only; change the password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_a_strong_password
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Administrator

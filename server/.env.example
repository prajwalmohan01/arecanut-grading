# Copy this to .env and fill in values (do not commit secrets)

# Database (local MongoDB by default)
MONGO_URI=mongodb://localhost:27017/arecanut_grading

# Auth (change this; minimum 16 characters)
JWT_SECRET=d79a99831c69c6e0c6599e4fc6e74448ed03f02e8d6a3c99f73b271b330fea1d
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=10

# ML inference
ML_TRANSPORT=local
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=120000
PYTHON_PATH=python
# Paths below are resolved from the project root, not from server/
MODEL_PATH=ml_service/weights/best.pt
MODEL_METADATA_PATH=ml_service/model_metadata.json

# Dense-image inference tuning (see README). These are operational defaults,
# not claims of measured accuracy.
MODEL_CONF=0.05
MODEL_IMGSZ=1280
MODEL_IOU=0.50
MODEL_MAX_DET=2000
MODEL_AUGMENT=false
USE_TILED=true
TILE_SIZE=640
TILE_OVERLAP=0.25
# Tiles are inferred at their native size. MODEL_IMGSZ is reserved for the
# full-image pass (small images and TILE_INCLUDE_FULL_IMAGE).
TILE_IMGSZ=640
# Cross-tile de-duplication is separate from the model's own NMS.
TILE_MERGE_IOU=0.45
TILE_DUPLICATE_CENTER_RATIO=0.30
TILE_CORE_OWNERSHIP=false
# Images must be at least this multiple of TILE_SIZE before tiling is used.
TILE_MIN_IMAGE_FACTOR=1.5
# Optional extra full-image pass on tiled runs; catches nuts spanning tiles at
# the cost of a second inference.
TILE_INCLUDE_FULL_IMAGE=false
# Persistent local worker: loads the model once instead of once per image.
USE_INFERENCE_WORKER=true
ML_WORKER_STARTUP_TIMEOUT_MS=90000
# Developer-only stage diagnostics. Keep false in normal operation.
MODEL_DEBUG=false
DEBUG_CONF_FLOOR=0.01

# Market and manual pricing
# These only seed the singleton settings document on first use. After an admin
# saves the toggles, the stored values are authoritative.
LIVE_PRICE_ENABLED=true
MANUAL_PRICE_ENABLED=true
MANDI_API_BASE_URL=https://mandi-api.onrender.com/v1
MANDI_STATE=Karnataka
MANDI_COMMODITY=Arecanut(Betelnut/Supari)
# The verified provider has no unit field; quintal is the documented convention.
MANDI_PRICE_UNIT=quintal
# Optional provider key (leave blank for the public endpoint).
MANDI_API_KEY=
MANDI_TIMEOUT_MS=12000
MANDI_CACHE_TTL_MINUTES=30
MANDI_DISTRICT=
MANDI_MARKET=
MANDI_VARIETY=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_MAX=600
BCRYPT_ROUNDS=10

# Admin bootstrap (local/dev only; change the password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=admin@gmail.com
ADMIN_DISPLAY_NAME=Administrator

# Roboflow Workflows (server-side only)
# ROBOFLOW_API_KEY must never be exposed to the browser
ROBOFLOW_API_KEY=8Rfyzaz1c3TKoLPNrwuZ
ROBOFLOW_API_URL=https://serverless.roboflow.com
ROBOFLOW_WORKSPACE=kiran-gowda-fzr2h
ROBOFLOW_WORKFLOW_GRADE=general-segmentation-api-2
ROBOFLOW_WORKFLOW_RIPENESS=general-segmentation-api-3
ROBOFLOW_WORKFLOW_RIPENESS_ALT=general-segmentation-api-3
ROBOFLOW_WORKFLOW_DETECT=general-segmentation-api-5
ROBOFLOW_API_KEY_TRANSPORT=header


# Gemini-assisted Grade C/D advisory (optional).
# Keys are read only by the server, never returned by the API, and never sent to the client.
# Provide one key or up to ten (GEMINI_API_KEY_1 .. GEMINI_API_KEY_10); they are deduplicated
# and used in order with cooldown/failover. Leave blank to keep Gemini unavailable.
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_4=
GEMINI_API_KEY_5=
# Defaults only; the admin UI can override the model, timeout, retry count, and image size.
GEMINI_MODEL=gemini-3.5-flash
GEMINI_TIMEOUT_MS=30000
GEMINI_MAX_RETRIES=2
GEMINI_IMAGE_MAX_DIMENSION=2048
GEMINI_COOLDOWN_MS=60000
GEMINI_MAX_OUTPUT_TOKENS=1600



# AGMARKNET daily mandi prices. The public AGMARKNET 2.0 dashboard is the
# default keyless source. Live pricing also requires an admin to select Live
# Market Price mode.
MARKET_PRICE_SOURCE=agmarknet_public
MARKET_PUBLIC_BASE_URL=https://api.agmarknet.gov.in/v1
MARKET_FILTERS_CACHE_MINUTES=360
MARKET_LOOKBACK_DAYS=7
MARKET_PRICE_TIMEOUT_MS=20000
MARKET_PRICE_CACHE_MINUTES=360

# Optional data.gov.in fallback when MARKET_PRICE_SOURCE=data_gov_in, or when
# the public dashboard fails. DATA_GOV_IN_API_KEY is preferred;
# AGMARKNET_API_KEY is accepted as a legacy alias.
DATA_GOV_IN_API_KEY=
AGMARKNET_API_KEY=
MARKET_PRICE_RESOURCE_ID=9ef84268-d588-465a-a308-a864a43d0070
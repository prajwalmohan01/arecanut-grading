# Copy this to .env and fill in values (do not commit secrets)

# Database (local MongoDB by default)
MONGO_URI=mongodb://localhost:27017/arecanut_grading

# Auth (change this; minimum 16 characters)
JWT_SECRET=d79a99831c69c6e0c6599e4fc6e74448ed03f02e8d6a3c99f73b271b330fea1d
JWT_EXPIRES_IN=7d

# Server
PORT=5000
NODE_ENV=development
TRUST_PROXY=false

# CORS
FRONTEND_URL=http://localhost:5173

# Uploads
MAX_UPLOAD_MB=10

# ML inference
ML_TRANSPORT=local
ML_SERVICE_URL=http://localhost:5001
ML_TIMEOUT_MS=120000
PYTHON_PATH=python
# Paths below are resolved from the project root, not from server/
MODEL_PATH=ml_service/weights/best.pt
MODEL_METADATA_PATH=ml_service/model_metadata.json

# Dense-image inference tuning (see README)
MODEL_CONF=0.05
MODEL_IMGSZ=1280
MODEL_IOU=0.50
MODEL_MAX_DET=2000
MODEL_AUGMENT=false
USE_TILED=true
TILE_SIZE=640
TILE_OVERLAP=0.25
# Tiles run at native size; MODEL_IMGSZ is used for the full-image path.
TILE_IMGSZ=640
# Cross-tile de-duplication (separate from the model's own NMS)
TILE_MERGE_IOU=0.45
TILE_DUPLICATE_CENTER_RATIO=0.30
TILE_CORE_OWNERSHIP=false
TILE_MIN_IMAGE_FACTOR=1.5
TILE_INCLUDE_FULL_IMAGE=false
# Persistent local inference worker (loads the model once per server lifetime)
USE_INFERENCE_WORKER=true
ML_WORKER_STARTUP_TIMEOUT_MS=90000
# Developer diagnostics only; keep false for normal use
MODEL_DEBUG=false
DEBUG_CONF_FLOOR=0.01

# Roboflow (optional, inspection/training reference only; not used at request time)
ROBOFLOW_API_KEY=
ROBOFLOW_API_URL=https://api.roboflow.com
ROBOFLOW_WORKSPACE=
ROBOFLOW_WORKFLOW_GRADE=
ROBOFLOW_WORKFLOW_RIPENESS=
ROBOFLOW_WORKFLOW_RIPENESS_ALT=
ROBOFLOW_WORKFLOW_DETECT=

# Rate limits
RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30
API_RATE_LIMIT_MAX=600
BCRYPT_ROUNDS=10

# Admin bootstrap (local/dev only; change the password)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin12345
ADMIN_EMAIL=
ADMIN_DISPLAY_NAME=Administrator
